# Fetched dataset files (see data/README.md) — never commit raw dataset
# contents here, whatever the source or license.
/data/*
!/data/README.md

# Trained model weights and training run logs
*.pt
*.pth
/logs/

# Virtual environment — never commit this, it's hundreds of MB of
# torch/CUDA binaries that don't belong in git history.
.venv/

# Common local cruft
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
